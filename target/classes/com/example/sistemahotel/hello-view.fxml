<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="900" styleClass="fundo" stylesheets="@estilo.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.sistemahotel.controller.HelloController">

  <top>
    <VBox alignment="CENTER" spacing="8" styleClass="cabecalho">
      <padding>
        <Insets bottom="30" left="25" right="25" top="30" />
      </padding>
      <Label styleClass="titulo" text="SISTEMA HOTEL" />
      <Region maxWidth="70" prefHeight="3" prefWidth="70" styleClass="linha-dourada" />
      <Label styleClass="subtitulo" text="Gestão de hóspedes, quartos e reservas" />
    </VBox>
  </top>

  <center>
    <VBox alignment="CENTER" spacing="25">
      <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
      </padding>

      <Label styleClass="titulo-menu" text="Menu principal" />

      <HBox alignment="CENTER" spacing="20">
        <Button fx:id="abrirTela" onAction="#abrirHospedes" styleClass="cartao" text="👤&#10;Hóspedes" />
        <Button onAction="#abrirQuartos" styleClass="cartao" text="🛏&#10;Quartos" />
        <Button onAction="#abrirReservas" styleClass="cartao" text="📅&#10;Reservas" />
      </HBox>

      <HBox alignment="CENTER" spacing="20">
        <Button onAction="#abrirPagamentos" styleClass="cartao" text="💳&#10;Pagamentos" />
        <Button onAction="#abrirLimpeza" styleClass="cartao" text="🧹&#10;Limpeza dos quartos" />
      </HBox>

      <Label fx:id="mensagem" styleClass="mensagem" text="Selecione uma opção para começar." wrapText="true" />
    </VBox>
  </center>

</BorderPane>
