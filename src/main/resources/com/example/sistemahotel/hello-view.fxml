<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.sistemahotel.controller.HelloController"
            prefWidth="800" prefHeight="500">

  <top>
    <VBox spacing="5" style="-fx-background-color: #243447;">
      <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
      </padding>
      <Label text="SISTEMA HOTEL"
             style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
      <Label text="Gestão de hóspedes, quartos e reservas"
             style="-fx-text-fill: #dce6f0; -fx-font-size: 14px;"/>
    </VBox>
  </top>

  <center>
    <VBox alignment="CENTER" spacing="20">
      <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
      </padding>

      <Label text="Menu principal"
             style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

      <HBox alignment="CENTER" spacing="15">
        <Button text="Hóspedes" onAction="#abrirHospedes"
                prefWidth="150" prefHeight="50"/>
        <Button text="Quartos" onAction="#abrirQuartos"
                prefWidth="150" prefHeight="50"/>
      </HBox>

      <HBox alignment="CENTER" spacing="15">
        <Button text="Reservas" onAction="#abrirReservas"
                prefWidth="150" prefHeight="50"/>
        <Button text="Pagamentos" onAction="#abrirPagamentos"
                prefWidth="150" prefHeight="50"/>
      </HBox>

      <Button text="Limpeza dos quartos" onAction="#abrirLimpeza"
              prefWidth="315" prefHeight="50"/>

      <Label fx:id="mensagem"
             text="Selecione uma opção para começar."
             wrapText="true"
             style="-fx-font-size: 14px;"/>
    </VBox>
  </center>

</BorderPane>
