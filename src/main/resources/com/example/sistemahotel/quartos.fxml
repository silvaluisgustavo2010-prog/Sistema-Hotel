
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.sistemahotel.controller.QuartosController"
            prefWidth="900.0"
            prefHeight="600.0"
            style="-fx-background-color: #f5f1ea;">

    <children>
        <VBox spacing="18.0"
              maxWidth="450.0"
              AnchorPane.topAnchor="55.0"
              AnchorPane.leftAnchor="225.0"
              AnchorPane.rightAnchor="225.0">

            <padding>
                <Insets top="25.0" right="30.0"
                        bottom="30.0" left="30.0"/>
            </padding>

            <Label text="Cadastro de Quartos"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243447;"/>

            <Label text="Preencha as informações do novo quarto."
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #666666;"/>

            <VBox spacing="6.0">
                <Label text="Tipo do quarto"/>
                <ComboBox fx:id="cmbTipoQuarto"
                          promptText="Selecione o tipo"
                          maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Número do quarto"/>
                <TextField fx:id="txtNumeroQuarto"
                           promptText="Ex.: 101"/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Capacidade de hóspedes"/>
                <TextField fx:id="txtCapacidade"
                           promptText="Ex.: 2"/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Valor da diária (R$)"/>
                <TextField fx:id="txtValorDiaria"
                           promptText="Ex.: 150,00"/>
            </VBox>

            <HBox alignment="CENTER">
                <Button text="Cadastrar quarto"
                        onAction="#cadastrarQuarto"
                        prefWidth="220.0"
                        prefHeight="42.0"
                        style="-fx-background-color: #243447;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8px;
                               -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
